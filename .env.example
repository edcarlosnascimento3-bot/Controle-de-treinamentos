# ============================================================
#  Controle de Treinamentos — configuração por ambiente
#  Copie este arquivo para ".env" e ajuste os valores.
#  A MESMA aplicação roda local e online: basta trocar
#  DATABASE_URL (e o host do servidor) quando for publicar.
# ============================================================

# Segredo usado para assinar os tokens de login (JWT) e os links do cartão.
# Em produção, gere um valor aleatório longo:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

# Cookie de sessão apenas via HTTPS. Deixe false em rede local sem HTTPS;
# ative true quando o site estiver publicado com https://
COOKIE_SECURE=false

# Quanto tempo o login fica válido (horas)
ACCESS_TOKEN_EXPIRE_HOURS=12

# ------------------------------------------------------------
# BANCO DE DADOS
# ------------------------------------------------------------
# LOCAL (padrão) — arquivo SQLite dentro de ./data
DATABASE_URL=sqlite:///./data/app.db

# ONLINE (quando for publicar) — exemplo com PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco

# ------------------------------------------------------------
# CERTIFICADOS / UPLOADS
# ------------------------------------------------------------
# Diretório onde os PDFs de certificado são salvos.
# Quando for para a nuvem, aponte para um bucket de objetos (S3 etc).
UPLOAD_DIR=./data/uploads

# ------------------------------------------------------------
# ALERTAS DE VENCIMENTO
# ------------------------------------------------------------
# Dias antes do vencimento em que o treinamento entra em "A vencer"
ALERTA_DIAS=60

# ------------------------------------------------------------
# QR CODE DO FUNCIONÁRIO
# ------------------------------------------------------------
# URL que o QR Code do cartão aponta. Para escanear pelo celular
# na mesma rede, use o IP local do PC (descubra com "ipconfig").
# Em produção, use o domínio público.
# PUBLIC_BASE_URL=http://192.168.0.10:8000

# ------------------------------------------------------------
# USUÁRIO ADMINISTRADOR INICIAL (criado na primeira execução)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@empresa.local
ADMIN_PASSWORD=admin123
